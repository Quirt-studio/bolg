# ============================================
# Bolg API - Multi-stage Docker build
# Build context: project root (F:/Bolg/)
# ============================================

# ---- Stage 1: Build Go binary ----
FROM golang:1.22-alpine AS builder

ENV GOPROXY=https://goproxy.cn,direct
RUN apk add --no-cache git ca-certificates

WORKDIR /src

# Copy go module files first (layer caching)
COPY bolg-api/go.mod bolg-api/go.sum ./
RUN go mod download

# Copy entire bolg-api source
COPY bolg-api/ ./

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bolg-api cmd/server/main.go

# ---- Stage 2: Minimal runtime ----
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata curl busybox-extras && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

# App directory layout:
#   /app/
#   ├── index.html          (served by Go)
#   ├── works.html          (served by Go)
#   └── bolg-api/
#       ├── bolg-api        (binary)
#       ├── config/
#       │   └── config.yaml (generated by entrypoint)
#       └── uploads/        (user content volume)

WORKDIR /app/bolg-api

# Copy Go binary
COPY --from=builder /bolg-api ./

# Copy entrypoint
COPY bolg-api/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Copy static HTML files from project root
COPY index.html works.html /app/

# Create uploads and config directories
RUN mkdir -p /app/bolg-api/config /app/bolg-api/uploads

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["./bolg-api"]
