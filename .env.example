# ============================================
# Bolg CMS - Environment Variables
# Copy to .env and customize:
#   cp .env.example .env
# ============================================

# HTTP port for the Nginx proxy
HTTP_PORT=80

# Gin mode: release | debug | test
GIN_MODE=release

# MySQL
DB_PASSWORD=bolg123
DB_NAME=bolg

# JWT (leave empty to auto-generate on first start)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=604800

# Max upload file size in bytes (default: 200MB)
MAX_FILE_SIZE=209715200
